# Crafty off-site backup config — copy to /etc/crafty/backup.env (chmod 600).
# NEVER commit a filled-in copy.

# --- CloudBase target ---
# Environment that holds the backup bucket. This is the env you already pay for.
TCB_ENV_ID=CHANGE_ME

# Remote directory. Must NOT start with '/'.
CLOUD_PREFIX=crafty-backups

# --- encryption ---
# Generated ONCE and stored in a password manager. If you lose this, every
# backup you have ever uploaded is unrecoverable.
#   openssl rand -base64 48
BACKUP_PASSPHRASE=CHANGE_ME

# --- database ---
# TCP rather than the unix socket: peer auth would map the backup process to
# the wrong OS user.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=crafty_app
PGDATABASE=crafty
PGPASSWORD=CHANGE_ME

# --- local staging ---
BACKUP_DIR=/var/backups/crafty
# Encrypted copies kept on the 9 GB disk. Cloud copies are kept independently.
LOCAL_KEEP_DAYS=7

# --- CLI location ---
TCB_BIN=/opt/tcb/node_modules/.bin/tcb
