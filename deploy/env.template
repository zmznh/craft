# Crafty runtime environment — copy to /etc/crafty/crafty.env on the server.
# NEVER commit a filled-in copy. Values below are placeholders.
#
# Generate secrets with:  openssl rand -hex 32

# --- database ---
# Local socket + dedicated app user. See README step 4.
DATABASE_URL=postgresql://crafty_app:CHANGE_ME@localhost:5432/crafty?sslmode=disable

# --- auth ---
# NEXTAUTH_SECRET and AUTH_SECRET must be the SAME value (next-auth v5 and the
# collab token verifier read different names for the same key).
NEXTAUTH_SECRET=CHANGE_ME_64_HEX_CHARS
AUTH_SECRET=CHANGE_ME_SAME_AS_NEXTAUTH_SECRET
COLLAB_SECRET=CHANGE_ME_64_HEX_CHARS
TLDRAW_INTERNAL_SECRET=CHANGE_ME_64_HEX_CHARS

# --- public URLs ---
# Public HTTPS path: point these at the three Caddy names.
NEXTAUTH_URL=https://crafty.example.com
NEXT_PUBLIC_APP_URL=https://crafty.example.com
NEXT_PUBLIC_COLLAB_URL=wss://collab.crafty.example.com
NEXT_PUBLIC_TLDRAW_SYNC_URL=wss://sync.crafty.example.com

# --- ports (bound to 127.0.0.1 by the systemd units) ---
COLLAB_PORT=3001
TLDRAW_SYNC_PORT=3002

# --- tldraw licensing ---
# Without a key the canvas renders for 5s then goes blank in production.
# Apply for a free Hobby License before exposing the public hostname.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# --- storage ---
# Leave STORAGE_DRIVER unset to keep uploads on local disk.
# STORAGE_DRIVER=cos
# COS_BUCKET=
# COS_REGION=
