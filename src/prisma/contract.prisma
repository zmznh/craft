// Crafty — Craft.do 1:1 Clone Database Schema (Prisma 8)

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  image         String?
  theme         String    @default("system")
  editorFont    String    @default("inter")
  editorWidth   String    @default("default")
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  documents     Document[]
  folders       Folder[]
  favorites     Favorite[]
  tags          Tag[]
  collections   Collection[]
  whiteboards   Whiteboard[]
  dailyNotesConfig DailyNotesConfig?
  tasks         Task[]

  @@map("users")
}

model Folder {
  id        String    @id @default(uuid())
  name      String    @default("未命名文件夹")
  icon      String?
  order     Float     @default(0)
  parentId  String?
  userId    String
  isDeleted Boolean   @default(false)
  deletedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]  @relation("FolderTree")
  documents Document[]
  collections Collection[]
  whiteboards Whiteboard[]

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

model Document {
  id            String    @id @default(uuid())
  title         String    @default("无标题")
  icon          String?
  coverImage    String?
  coverType     String?
  content       Json?
  plainText     String    @default("")
  order         Float     @default(0)

  parentId      String?
  folderId      String?
  userId        String

  font          String?
  width         String?
  pageStyle     Json?

  isTemplate    Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedAt     TimestamptzString?

  isDailyNote   Boolean   @default(false)
  dailyNoteDate TimestamptzString?

  wordCount     Int       @default(0)
  charCount     Int       @default(0)

  version       Int       @default(1)

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Document? @relation("DocumentTree", fields: [parentId], references: [id])
  children      Document[] @relation("DocumentTree")
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  favorites     Favorite[]
  tags          DocumentTag[]
  backlinks     Backlink[] @relation("LinkedDocument")
  linkingDocs   Backlink[] @relation("SourceDocument")
  versions      DocumentVersion[]
  tasks         Task[]
  shares        DocumentShare[]

  @@index([userId])
  @@index([folderId])
  @@index([parentId])
  @@index([isDeleted])
  @@index([isDailyNote, dailyNoteDate])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  version     Int
  title       String
  content     Json
  plainText   String   @default("")
  wordCount   Int      @default(0)
  createdAt   TimestamptzString @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

model Collection {
  id          String   @id @default(uuid())
  name        String   @default("未命名集合")
  icon        String?
  description String?
  order       Float    @default(0)
  folderId    String?
  userId      String
  isDeleted   Boolean  @default(false)
  deletedAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  properties  CollectionProperty[]
  items       CollectionItem[]
  views       CollectionView[]

  @@index([userId])
  @@index([folderId])
  @@map("collections")
}

model CollectionProperty {
  id           String   @id @default(uuid())
  collectionId String
  name         String
  type         String
  config       Json?
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  width        Int?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  values       CollectionValue[]

  @@index([collectionId])
  @@map("collection_properties")
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  order        Float    @default(0)
  documentId   String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  document     Document?  @relation(fields: [documentId], references: [id])
  values       CollectionValue[]

  @@index([collectionId])
  @@map("collection_items")
}

model CollectionValue {
  id           String   @id @default(uuid())
  itemId       String
  propertyId   String
  value        Json?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  item         CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  property     CollectionProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([itemId, propertyId])
  @@map("collection_values")
}

model CollectionView {
  id           String   @id @default(uuid())
  collectionId String
  name         String   @default("默认视图")
  type         String
  config       Json?
  isActive     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("collection_views")
}

model Whiteboard {
  id          String   @id @default(uuid())
  name        String   @default("未命名白板")
  icon        String?
  data        Json?
  order       Float    @default(0)
  folderId    String?
  userId      String
  isDeleted   Boolean  @default(false)
  deletedAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@map("whiteboards")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  userId    String
  createdAt TimestamptzString @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents DocumentTag[]

  @@unique([name, userId])
  @@map("tags")
}

model DocumentTag {
  documentId String
  tagId      String
  createdAt  TimestamptzString @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([documentId, tagId])
  @@map("document_tags")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  order      Float    @default(0)
  createdAt  TimestamptzString @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("favorites")
}

model Backlink {
  id               String   @id @default(uuid())
  sourceDocumentId String
  linkedDocumentId String
  sourceBlockId    String?
  createdAt        TimestamptzString @default(now())

  sourceDocument   Document @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  linkedDocument   Document @relation("LinkedDocument", fields: [linkedDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, linkedDocumentId])
  @@map("backlinks")
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  documentId  String?
  blockId     String?
  title       String
  isCompleted Boolean  @default(false)
  dueDate     TimestamptzString?
  status      String   @default("todo") // "todo" | "doing" | "done"
  order       Float    @default(0)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, isCompleted])
  @@index([userId, dueDate])
  @@index([documentId, blockId])
  @@map("tasks")
}

model DocumentShare {
  id           String   @id @default(uuid())
  documentId   String
  token        String   @unique
  passcode     String?
  isPublished  Boolean  @default(false)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_shares")
}

model DailyNotesConfig {
  id          String   @id @default(uuid())
  userId      String   @unique
  folderId    String?
  templateId  String?
  startTime   String   @default("00:00")
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_notes_config")
}

model CommentThread {
  id           String   @id @default(uuid())
  documentId   String
  blockId      String?
  blockText    String   @default("")
  resolved     Boolean  @default(false)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments     Comment[]

  @@index([documentId, resolved])
  @@map("comment_threads")
}

model Comment {
  id         String   @id @default(uuid())
  threadId   String
  userId     String
  body       String
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  thread     CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("comments")
}
